# Extraccion (job puntual) + postgresql-client + dbt/seeds/
# (el extractor lee exchange_assets.csv). Esta es la imagen que Railway
# buildea y programa como cron (ver railway.toml).
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ src/
COPY dbt/ dbt/
COPY sql/ sql/

CMD ["python", "-m", "src.pipeline"]
